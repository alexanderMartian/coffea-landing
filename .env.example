# Copy to .env.local and fill in. Never commit real values.
# Resend — https://resend.com/api-keys (permission: Sending access)
RESEND_API_KEY=
# Where signup notifications go. Without an own domain Resend only delivers to the account's own email.
NOTIFICATION_EMAIL=

# Contact form — fill in when the form backend is added
# CONTACT_TO_EMAIL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Production site URL (used for metadata, sitemap, robots). Leave empty for local dev.
# NEXT_PUBLIC_SITE_URL=https://coffea.example.com
